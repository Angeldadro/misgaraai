{
  "name": "@misgara/ai-agent",
  "version": "1.1.0",
  "description": "Librería hexagonal para agentes de IA",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "tsx src/demo.ts",
    "demo:media": "tsx src/demo-media.ts",
    "build": "tsc",
    "check:package": "npm pack --dry-run",
    "release:verify": "npm run clean && npm run typecheck && npm run build && npm run check:package",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run release:verify"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "ai",
    "agent",
    "gemini",
    "openai",
    "whisper",
    "deepseek",
    "ocr",
    "vercel-ai-sdk"
  ],
  "publishConfig": {
    "access": "public"
  },
  "author": "misgara",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@ai-sdk/deepinfra": "^2.0.26",
    "@ai-sdk/google": "^3.0.6",
    "@ai-sdk/openai": "^3.0.7",
    "ai": "^6.0.27",
    "dotenv": "^17.2.3",
    "ioredis": "^5.9.1",
    "mathjs": "^15.1.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/ioredis": "^4.28.10",
    "@types/node": "^25.0.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
